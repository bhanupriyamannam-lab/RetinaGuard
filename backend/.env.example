# RetinaGuard Backend Configuration Environment Variables

SECRET_KEY=retinaguard-super-secret-key-change-in-production-2026
DEBUG=True
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL in production:
# DATABASE_URL=postgresql://retinaguard:password@localhost:5432/retinaguard_db

ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173

JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

MEDIA_ROOT=media
MEDIA_URL=/media/
MAX_UPLOAD_SIZE=26214400

AI_PROVIDER=mock
AI_MODEL_PATH=ai/models
DEMO_MODE=true
ASYNC_AI=false

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
